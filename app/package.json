{
  "name": "app",
  "scripts": {
    "dev": "bun run css && bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "css": "tailwindcss -i ./src/styles/globals.css -o ./public/styles.css",
    "css:watch": "tailwindcss -i ./src/styles/globals.css -o ./public/styles.css --watch",
    "build:css": "tailwindcss -i ./src/styles/globals.css -o ./public/styles.css --minify",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.6",
    "hono": "^4.13.7",
    "lucide": "^0.575.0",
    "postgres": "^3.4.7",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "@tailwindcss/cli": "^4.1.16",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.6",
    "tailwindcss": "^4.1.16"
  }
}
